{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AliasMode",
  "version": "0.1.0-beta.3",
  "identifier": "com.aliasmode.desktop",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/aliasmode-sidecar"],
    "resources": {
      "resources/cloakbrowser/": "cloakbrowser/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
