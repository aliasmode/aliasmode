{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AliasMode",
  "version": "0.1.0-beta.70",
  "identifier": "com.aliasmode.desktop",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "publisher": "AliasMode",
    "copyright": "Copyright © 2026 Xreacher",
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/aliasmode-sidecar"],
    "resources": {
      "resources/firefox/": "firefox/",
      "resources/playwright/": "playwright/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "compression": "zlib",
        "languages": ["English", "SimpChinese"],
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RENCMkQ0NjNGRDgyQ0UKUldUT2d2MWoxTExjeDVvdWJHM2pNRnRPd2NwMm82WlJici9TYzByK2lkdlh2YUplQ09NOFhwN2cK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
