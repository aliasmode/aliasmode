{
  "name": "aliasmode",
  "version": "0.1.0-beta.45",
  "description": "Local-first browser profile manager with optional cloud synchronization",
  "module": "cli.ts",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "bun cli.ts start",
    "serve": "bun cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "bun scripts/prepare-windows-bundle.ts",
    "desktop:build:nsis": "bun run desktop:prepare && tauri build --bundles nsis --no-sign",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "latest",
    "@types/cross-spawn": "6.0.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.56",
    "@tauri-apps/api": "2.11.1",
    "cross-spawn": "7.0.6",
    "csv-parse": "^7.0.2",
    "playwright": "1.58.0-alpha-2026-01-16",
    "playwright-core": "1.58.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "8.21.0"
  },
  "patchedDependencies": {
    "playwright-core@1.58.2": "patches/playwright-core@1.58.2.patch"
  }
}
